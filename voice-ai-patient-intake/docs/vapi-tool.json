{
  "name": "register_patient",
  "description": "Register a patient after the caller has reviewed and confirmed all collected information.",
  "parameters": {
    "type": "object",
    "properties": {
      "first_name": { "type": "string" },
      "last_name": { "type": "string" },
      "date_of_birth": { "type": "string", "description": "YYYY-MM-DD" },
      "sex": {
        "type": "string",
        "enum": ["Male", "Female", "Other", "Decline to Answer"]
      },
      "phone_number": { "type": "string", "description": "U.S. 10-digit phone number" },
      "email": { "type": "string" },
      "address_line_1": { "type": "string" },
      "address_line_2": { "type": "string" },
      "city": { "type": "string" },
      "state": { "type": "string", "description": "Two-letter U.S. state abbreviation" },
      "zip_code": { "type": "string" },
      "insurance_provider": { "type": "string" },
      "insurance_member_id": { "type": "string" },
      "preferred_language": { "type": "string" },
      "emergency_contact_name": { "type": "string" },
      "emergency_contact_phone": { "type": "string" }
    },
    "required": [
      "first_name",
      "last_name",
      "date_of_birth",
      "sex",
      "phone_number",
      "address_line_1",
      "city",
      "state",
      "zip_code"
    ],
    "additionalProperties": false
  }
}
